<%- include('./partials/header') %>
<div class="max-w-[700px] mx-auto p-6 bg-white rounded-lg shadow-md">
  <!-- Заголовок и кнопка -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-4xl font-bold text-gray-900"><%= book.title %></h1>
    <a href="/books/update/<%= book._id %>" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded transition">
      Редактировать
    </a>
  </div>

  <!-- Описание и детали -->
  <div class="text-gray-700 space-y-4">
    <p><strong>Автор:</strong> <%= book.authors %></p>
    <div class="flex items-center">
      <strong class="mr-2">Описание:</strong>
      <div class="whitespace-pre-line"><%= book.description %></div>
    </div>
    <p>
      <strong>Избранное:</strong>
      <% if (book.favorite) { %>
        <span class="text-yellow-400 text-xl align-middle select-none" title="В избранном">&#9733;</span>
      <% } else { %>
        <span class="text-gray-400 text-xl align-middle select-none" title="Не в избранном">&#9733;</span>
      <% } %>
    </p>
    <p><strong>ID книги:</strong> <%= book._id %></p>
    <p><strong>Просмотры:</strong> <%= viewCounter %></p>
  </div>

  <!-- Форма добавления комментария -->
   
  <form id="commentForm" data-bookid="<%= book._id %>" class="flex flex-col space-y-4 mt-7">
    <h2 class="text-2xl font-semibold mb-4">Комментарии</h2>
    <textarea id="commentText" name="commentText" rows="3" class="border border-gray-400 rounded p-2 resize-none" placeholder="Введите комментарий..." required></textarea>
    <button id="submitComment" class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded font-semibold w-36 self-end">Отправить</button>
  </form>

  <!-- Блок комментариев -->
  <div id="comments" class="mt-5">
    <div id="commentsList" class="space-y-4 mb-6">
      <% comments.forEach(comment => { %>
        <%- include('./components/comment', { comment: comment }) %>
      <% }); %>
    </div>
  </div>
</div>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
<script src="/js/pages/viewPage.js" type="module"></script>
</body>
</html>

